# Environment variables for PatientTriage.ai ML Core Engine
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://triage_user:triage_pass@localhost:5432/triage_db

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0

# MLflow Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
API_KEY_SECRET=change_me_in_production_use_strong_random_key
ADMIN_TOKEN_SECRET=change_me_in_production_use_strong_random_key

# Monitoring
PROMETHEUS_PORT=9090
SENTRY_DSN=

# Feature Flags
ENABLE_SHADOW_MODE=false
ENABLE_SURGE_MODE=false

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_HOUR=500

# Logging
LOG_LEVEL=INFO
